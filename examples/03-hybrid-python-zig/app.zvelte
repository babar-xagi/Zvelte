<script lang="python" context="server">
from datetime import datetime
import math

service_name = "Zvelte AI Core"

def get_server_status():
    return f"Python Server Online (CPython {datetime.now().strftime('%H:%M:%S')})"

def ask_ai(prompt):
    return f"AI Neural Result: Analysis of '{prompt}' completed with confidence 0.98."

def compute_factorial(n):
    return f"{n}! = {math.factorial(int(n))}"

def benchmark_native_fib(n):
    # Calls compiled Zig shared library via ctypes at machine code speed!
    val = zvelte_fast_fib(int(n))
    return f"Zig Native Fibonacci({n}) = {val} (sub-microsecond execution)"
</script>

<script lang="zig" context="native">
pub export fn zvelte_multiply(a: i32, b: i32) callconv(.c) i32 {
    return a * b;
}

pub export fn zvelte_fast_fib(n: u32) callconv(.c) u64 {
    if (n <= 1) return n;
    var a: u64 = 0;
    var b: u64 = 1;
    var i: u32 = 2;
    while (i <= n) : (i += 1) {
        const next = a + b;
        a = b;
        b = next;
    }
    return b;
}
</script>

<script lang="zig" context="wasm">
pub export fn zvelte_cube(value: i32) callconv(.c) i32 {
    return value * value * value;
}
</script>

<state>
multiplier: i32 = 2
count: i32 = 10
user_prompt: string = "Summarize market trends"
ai_result: string = ""
native_mul_result: i32 = 20
native_fib_result: string = ""
</state>

<main>
    <div class="container">
        <h1>⚡ Zvelte Multi-Language Hybrid Example</h1>
        <p class="status">{get_server_status()}</p>

        <section class="card native-card">
            <h2>⚡ Zig Native Acceleration (C-ABI ctypes)</h2>
            <p>Compute <code>{count} × {multiplier}</code> in compiled machine code:</p>
            <button class="btn btn-native" click={zvelte_multiply(count, multiplier).then(res => { native_mul_result = res; update(); })}>
                Run Zig Multiply ➔ Result: {native_mul_result}
            </button>

            <div style="margin-top: 0.75rem;">
                <button class="btn btn-native" click={benchmark_native_fib(count).then(res => { native_fib_result = res; update(); })}>
                    Compute Native Fibonacci({count})
                </button>
            </div>
            {#if native_fib_result}
                <div class="native-box">{native_fib_result}</div>
            {/if}
        </section>

        <section class="card server-card">
            <h2>🐍 Python Server RPC & AI Engine</h2>
            <div class="rpc-input">
                <input type="text" class="input-text" bind:value={user_prompt} placeholder="Ask Python AI..." />
                <button class="btn btn-ai" click={ask_ai(user_prompt).then(res => { ai_result = res; update(); })}>
                    Run Python AI
                </button>
            </div>
            {#if ai_result}
                <div class="ai-box">{ai_result}</div>
            {/if}
        </section>

        <section class="card">
            <h2>Client Reactive State</h2>
            <p>Current count: <strong>{count}</strong></p>
            <p>Multiplier factor: <strong>{multiplier}</strong></p>

            <div class="btn-group">
                <button class="btn" click={count++}>
                    Increment Count
                </button>
                <button class="btn" click={multiplier++}>
                    Increase Multiplier
                </button>
                <button class="btn btn-reset" click={count = 0}>
                    Reset Count
                </button>
            </div>
        </section>
    </div>
</main>

