<script lang="python" context="server">
from datetime import datetime

service_name = "Zvelte Hybrid Core"

def get_server_status():
    return f"Active on {datetime.now().strftime('%Y-%m-%d')}"
</script>

<script lang="zig" context="native">
pub export fn zvelte_multiply(a: i32, b: i32) callconv(.c) i32 {
    return a * b;
}
</script>

<script lang="zig" context="wasm">
pub export fn zvelte_cube(value: i32) callconv(.c) i32 {
    return value * value * value;
}
</script>

<state>
multiplier: i32 = 2
count: i32 = 10
</state>

<main>
    <div class="container">
        <h1>⚡ Zvelte Multi-Language Hybrid Example</h1>
        <p class="status">{get_server_status()}</p>

        <section class="card">
            <h2>Client Reactive State</h2>
            <p>Current count: <strong>{count}</strong></p>
            <p>Multiplier factor: <strong>{multiplier}</strong></p>

            <div class="btn-group">
                <button class="btn" click={count++}>
                    Increment Count
                </button>
                <button class="btn" click={multiplier++}>
                    Increase Multiplier
                </button>
                <button class="btn btn-reset" click={count = 0}>
                    Reset Count
                </button>
            </div>
        </section>
    </div>
</main>

