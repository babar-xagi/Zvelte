    font-size: 12px;
    font-weight: 600;
}
.badge-rust {
    background: #ce412b;
    color: white;
}
.badge-python {
    background: #3776ab;
    color: white;
}
.card {
    background: #1e293b;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
}
.button-row {
    display: flex;
    gap: 12px;
    margin-top: 12px;
}
button {
    background: #38bdf8;
    color: #0f172a;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
}
button:hover {
    background: #7dd3fc;
}
.output-box {
    background: #0b1120;
    border: 1px solid #334155;
