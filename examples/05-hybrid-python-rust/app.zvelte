    margin-top: 16px;
}
</style>

<div class="rustby-container">
    <div class="header">
        <h1>🦀 Rustby (Zvelte-RS) Reactive App</h1>
        <div class="badge-row">
            <span class="badge badge-rust">Rust C-ABI cdylib</span>
            <span class="badge badge-python">CPython RPC</span>
        </div>
    </div>

    <div class="card">
        <h2>Client-Side Reactive Counter (Svelte Style)</h2>
        <p>Active state: count = <strong>{count}</strong></p>
        <div class="button-row">
            <button click={count++}>Increment (+1)</button>
            <button click={count--}>Decrement (-1)</button>
            <button click={count = 0}>Reset</button>
        </div>
    </div>

    <div class="card">
        <h2>Server & Native Rust Invocations</h2>
        <p>Hello <strong>{user_name}</strong>! Welcome to <strong>{service_name}</strong>.</p>
        <div class="button-row">
            <button click={server_output = get_server_status()}>Check Server Status</button>
            <button click={server_output = compute_factorial(count)}>Compute Factorial ({count}!)</button>
            <button click={server_output = benchmark_rust_fib(40)}>Native Rust Fib(40)</button>
        </div>
        <div class="output-box">
            {server_output}
        </div>
    </div>
</div>
