<script lang="rust">
#[no_mangle]
pub extern "C" fn rust_multiply(a: i32, b: i32) -> i32 {
    a * b
}

#[no_mangle]
pub extern "C" fn rust_fast_fib(n: u32) -> u64 {
    if n <= 1 {
        return n as u64;
    }
    let mut a: u64 = 0;
    let mut b: u64 = 1;
    for _ in 2..=n {
        let next = a + b;
        a = b;
        b = next;
    }
    b
}
</script>

<script lang="python">
from datetime import datetime
import math

service_name = "Rustby Reactive Engine"
count = 5
user_name = "Developer"
server_output = "Click a button to execute Python or Native Rust!"

def get_server_status():
    return f"Python Worker Online (Time: {datetime.now().strftime('%H:%M:%S')})"

def compute_factorial(n):
    return f"{n}! = {math.factorial(int(n))}"

def benchmark_rust_fib(n):
    val = rust_fast_fib(int(n))
    return f"Native Rust Fibonacci({n}) = {val:,} (computed in sub-microseconds via C-ABI)"
</script>

<style>
