<state>
count: i32 = 0
</state>

<main>
    <div class="card">
        <h1>⚡ Zvelte Reactive Counter</h1>
        <p class="subtitle">Fine-grained DOM updates without Virtual DOM</p>

        <div class="counter-display">
            <span class="label">Count</span>
            <span class="value">{count}</span>
        </div>

        <div class="button-group">
            <button class="btn btn-primary" click={count++}>
                + Increment
            </button>
            <button class="btn btn-secondary" click={count--}>
                - Decrement
            </button>
            <button class="btn btn-danger" click={count = 0}>
                ↺ Reset
            </button>
        </div>
    </div>
</main>

