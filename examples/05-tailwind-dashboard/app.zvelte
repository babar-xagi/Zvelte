<script lang="python">
from datetime import datetime

active_users = 128
dark_theme = True
search_filter = ""
server_summary = "Click 'Sync Python Analytics' to query live server metrics."

def get_analytics(users):
    u = int(users)
    throughput = u * 42
    ts = datetime.now().strftime("%H:%M:%S")
    return f"Live Server Sync ({ts}) — {u} active users processing {throughput:,} req/min"
</script>

<state>
services: []string = ["Python JSON-RPC Worker", "Zero-Dep Rust Compiler", "Built-in Tailwind Engine"]
</state>

<style>
.pill-badge {
    @apply inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/30;
}
</style>

<div class={dark_theme ? "dark" : ""}>
    <main class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200 p-6 md:p-10">
        <div class="max-w-4xl mx-auto space-y-6">
            <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
                <div>
                    <span class="pill-badge">v0.0.7 + Full Tailwind CSS</span>
                    <h1 class="mt-2 text-3xl font-extrabold bg-gradient-to-r from-sky-400 via-indigo-400 to-purple-500 bg-clip-text text-transparent">
                        Zvelte Tailwind Dashboard
                    </h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        Zero npm, zero node_modules — compiled natively in Rust.
                    </p>
                </div>
                <button
                    class="px-4 py-2 rounded-lg font-semibold text-sm bg-slate-900 text-white dark:bg-slate-800 dark:hover:bg-slate-700 hover:bg-slate-800 border border-slate-700/50 transition cursor-pointer"
                    click={dark_theme = !dark_theme}
                >
                    Toggle Theme
                </button>
            </header>

            <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg">
                    <p class="text-xs uppercase tracking-wider text-slate-500">Active Users</p>
                    <p class="mt-1 text-3xl font-bold text-sky-500">{active_users}</p>
                    <div class="mt-4 flex gap-2">
                        <button class="px-3 py-1.5 rounded-md bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold cursor-pointer" click={active_users += 10}>
                            +10 Users
                        </button>
                        <button class="px-3 py-1.5 rounded-md bg-slate-700 hover:bg-slate-600 text-white text-xs font-semibold cursor-pointer" click={active_users = 128}>
                            Reset
                        </button>
                    </div>
                </div>

                <div class="md:col-span-2 p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <p class="text-xs uppercase tracking-wider text-slate-500">Python Telemetry</p>
                            <span class="size-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        </div>
                        <p class="mt-2 font-mono text-sm text-emerald-500 dark:text-emerald-400">{server_summary}</p>
                    </div>
                    <div class="mt-4 flex flex-col sm:flex-row gap-3">
                        <input
                            type="text"
                            bind:value={search_filter}
                            placeholder="Filter note..."
                            class="flex-1 px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:ring-2 focus:ring-sky-500/50 outline-none"
                        />
                        <button
                            class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-md cursor-pointer transition"
                            click={server_summary = get_analytics(active_users)}
                        >
                            Sync Python Analytics
                        </button>
                    </div>
                </div>
            </section>

            <section class="p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md">
                <h2 class="text-lg font-bold mb-3">Active Stack Services ({services.length})</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {#each services as svc}
                        <div class="px-4 py-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm font-medium">
                            ✔ {svc}
                        </div>
                    {/each}
                </div>
            </section>
        </div>
    </main>
</div>
