    font-size: 1.5rem;
    font-weight: 700;
    color: #38bdf8;
    margin: 0;
}
.subtitle {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
}
.badge {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
}
.provider-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    background: #1a2234;
    padding: 0.75rem 1rem;
    border-radius: 10px;
}
.label {
    font-size: 0.85rem;
    color: #cbd5e1;
}
.pill-group {
    display: flex;
    gap: 0.5rem;
}
.pill {
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
}
.pill:hover {
    border-color: #38bdf8;
}
.active-tag {
    font-size: 0.85rem;
    color: #38bdf8;
    margin-left: auto;
}
.messages-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
    min-height: 18rem;
}
.msg-card {
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 12px;
}
.msg-card.user {
    background: #1e293b;
    border-left: 4px solid #38bdf8;
}
.msg-card.ai {
    background: #162032;
    border-left: 4px solid #22c55e;
}
.avatar {
    font-size: 1.4rem;
}
.content {
    flex: 1;
}
.role {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #94a3b8;
    display: block;
    margin-bottom: 0.25rem;
}
.bubble {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #f1f5f9;
    white-space: pre-wrap;
}
.pulse {
    color: #38bdf8;
    font-style: italic;
}
.input-bar {
    display: flex;
    gap: 0.75rem;
}
.chat-input {
    flex: 1;
    background: #0f172a;
    border: 1px solid #334155;
    color: #f8fafc;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 1rem;
    outline: none;
}
.chat-input:focus {
    border-color: #38bdf8;
}
.btn-send {
    background: #0284c7;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
