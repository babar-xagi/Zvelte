<state>
todos: []string = ["Install Zvelte (Rust + Python)", "Build first Zvelte application", "Deploy fine-grained reactive app"]
completed_tasks: i32 = 1
new_task: string = ""
</state>

<main>
    <div class="app-container">
        <header>
            <h1>📝 Zvelte Task Manager</h1>
            <p>Tasks completed: {completed_tasks} of {todos.length}</p>
        </header>

        {#if completed_tasks >= todos.length}
            <div class="banner-complete">🎉 All tasks completed! Great job!</div>
        {:else}
            <div class="banner-pending">⚡ Tasks in progress</div>
        {/if}

        <div class="add-task-form">
            <input type="text" class="input-task" placeholder="Enter a new task..." bind:value={new_task} />
            <button class="btn btn-add" click={todos.push(new_task); new_task = ""}>
                + Add Task
            </button>
        </div>

        <div class="task-list">
            {#each todos as todo}
                <div class="task-item">
                    <span class="checkbox">✔</span>
                    <span class="task-title">{todo}</span>
                </div>
            {/each}
        </div>

        <div class="actions">
            <button class="btn" click={completed_tasks++}>
                ✔ Complete Next Task
            </button>
            <button class="btn btn-reset" click={completed_tasks = 0}>
                ↺ Reset Progress
            </button>
        </div>
    </div>
</main>

<style>
main {
    font-family: system-ui, -apple-system, sans-serif;
    background: #f1f5f9;
    color: #334155;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
}
.app-container {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    max-width: 32rem;
    width: 100%;
}
header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
    color: #0f172a;
}
header p {
    margin: 0 0 1.5rem 0;
    color: #64748b;
    font-size: 0.875rem;
}
.banner-complete {
    background: #dcfce7;
    color: #15803d;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
}
.banner-pending {
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
}
.add-task-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}
.input-task {
    flex: 1;
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.95rem;
}
.task-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
}
.task-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
}
.checkbox {
    font-size: 1.1rem;
    color: #22c55e;
}
.actions {
    display: flex;
    gap: 0.75rem;
}
.btn {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
}
.btn:hover {
    background: #2563eb;
}
.btn-add {
    background: #059669;
}
.btn-add:hover {
    background: #047857;
}
.btn-reset {
    background: #e2e8f0;
    color: #475569;
}
.btn-reset:hover {
    background: #cbd5e1;
}
</style>
