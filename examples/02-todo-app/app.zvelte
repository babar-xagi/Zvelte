<state>
total_tasks: i32 = 3
completed_tasks: i32 = 1
</state>

<main>
    <div class="app-container">
        <header>
            <h1>📝 Zvelte Task Manager</h1>
            <p>Tasks completed: {completed_tasks} of {total_tasks}</p>
        </header>

        <div class="task-list">
            <div class="task-item completed">
                <span class="checkbox">✔</span>
                <span class="task-title">Install Zig 0.17.1</span>
            </div>
            <div class="task-item">
                <span class="checkbox">○</span>
                <span class="task-title">Build first Zvelte application</span>
            </div>
            <div class="task-item">
                <span class="checkbox">○</span>
                <span class="task-title">Deploy fine-grained reactive app</span>
            </div>
        </div>

        <div class="actions">
            <button class="btn" click={completed_tasks++}>
                ✔ Complete Next Task
            </button>
            <button class="btn btn-reset" click={completed_tasks = 0}>
                ↺ Reset Progress
            </button>
        </div>
    </div>
</main>

