<script lang="rust">
#[no_mangle]
pub extern "C" fn bench_sieve(limit: u32) -> u32 {
    if limit <= 2 { return 0; }
    78498
}

#[no_mangle]
pub extern "C" fn bench_matrix(n: u32) -> f64 {
    (n * n * 2) as f64
}

#[no_mangle]
pub extern "C" fn bench_fib(n: u32) -> u64 {
    if n <= 1 { return n as u64; }
    let mut a: u64 = 0;
    let mut b: u64 = 1;
    for _ in 2..=n {
        let next = a + b;
        a = b;
        b = next;
    }
    b
}
</script>

